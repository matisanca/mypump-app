<?xml version="1.0" encoding="utf-8"?>
<!--
  MyPump — Android

  SOBRE LOS PERMISOS DE SALUD
  El plugin @capgo/capacitor-health declara 43 permisos en SU manifest: 22 de
  lectura y 21 de escritura, o sea todo lo que el plugin sabe hacer, lo use la
  app o no. El manifest merger los suma acá automáticamente.

  Eso no puede quedar así, por dos motivos:

  1. MyPump SOLO LEE. Nunca escribe un dato de salud. Declarar 21 permisos de
     escritura es pedir acceso a algo que no se usa — y en la pantalla de
     Health Connect el cliente ve la lista completa de lo que la app pidió.

  2. Google hace justificar CADA permiso, uno por uno, en la "Health apps
     declaration" de Play Console. Un permiso declarado y no usado es una
     pregunta que no tiene buena respuesta, y una causa de rechazo.

  Por eso van con tools:node="remove", que le dice al merger que los saque
  aunque la librería los traiga. Quedan los 17 de lectura que el bridge
  efectivamente pide (public/js/healthkit-bridge.js, tablas AGG y SAMPLES
  filtradas por `soloIOS`).

  OJO AL AGREGAR UN TIPO NUEVO AL BRIDGE: hay que agregar acá su permiso de
  lectura. Pedir en runtime un permiso que el manifest no declara tira
  SecurityException. scripts/check-android-permisos.mjs verifica que las dos
  listas coincidan y falla el build si se desincronizan.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Link personal del coach: https://app.mypumpteam.com/?t=TOKEN
              Es el mismo mecanismo que el Universal Link de iOS. Sin esto, el
              cliente que toca el link de WhatsApp abre el navegador en vez de
              la app, y ahí no hay Health Connect.

              autoVerify pide que Android valide el dominio contra
              /.well-known/assetlinks.json antes de quedarse con el link, para
              que ninguna otra app pueda robárselo.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.mypumpteam.com" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Notificaciones (Android 13+). Las locales y las push las manejan los
         plugins de Capacitor que ya están instalados. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ── Health Connect: SOLO LECTURA, solo lo que el bridge pide ──────── -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" />
    <!-- READ_OXYGEN_SATURATION sacado el 28-ago-2026: Google rechazó la app
         por él ("acceso excesivo a datos de la función declarada"). No
         alimentaba ninguna función, solo se mostraba. En iOS sigue.
         Para volver a pedirlo tiene que existir antes una función que lo use. -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />

    <!-- Historial más viejo que 30 días. NO es un tipo de dato: es la llave que
         abre el pasado. Sin esto, Health Connect corta toda lectura a los
         últimos 30 días y NO avisa — devuelve cero muestras, que no es una
         excepción. El backfill pide 60 días, las 6 primeras ventanas vuelven
         vacías, y la app marca el historial como completo teniendo la mitad.
         Se pide con requestHistoryAccess:true (healthkit-bridge.js). -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <!-- ── Cortados a propósito en Android, aunque en iOS sí se leen ──────
         Google hace justificar cada permiso de salud uno por uno, y pedir
         glucosa en sangre en una app de coaching fitness invita a preguntas.
         Los tres pesan dentro del componente "otros" del score (8 de 100) y
         casi nadie tiene un sensor que los escriba a Health Connect.
         Van con node="remove" y no borrados a secas: el manifest del plugin
         los declara y el merger los volvería a meter. -->
    <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_GLUCOSE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_MINDFULNESS" tools:node="remove" />

    <!-- ── Lo que el plugin trae y NO se usa ─────────────────────────────
         Lectura: tipos que el bridge no pide.
         Escritura: TODOS. MyPump nunca escribe en Health Connect. -->
    <uses-permission android:name="android.permission.health.READ_BASAL_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_VO2_MAX" tools:node="remove" />

    <uses-permission android:name="android.permission.health.WRITE_STEPS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BASAL_METABOLIC_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BASAL_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_GLUCOSE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_PRESSURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_FAT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_FLOORS_CLIMBED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE_VARIABILITY" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_HEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_MINDFULNESS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_OXYGEN_SATURATION" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_RESPIRATORY_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_RESTING_HEART_RATE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_SLEEP" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_TOTAL_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_VO2_MAX" tools:node="remove" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" tools:node="remove" />

    <!--
      Android 13 y anteriores: Health Connect es una app aparte, y para que
      aparezca en su lista de "apps conectadas" hay que declarar que se puede
      consultar. Sin esto, en un Android 13 la app no encuentra Health Connect
      y el cliente ve "no disponible" sin más explicación.
      En Android 14+ Health Connect está en el sistema y esto es inocuo.
    -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>
</manifest>
