<resources>
    <string name="app_name">MyPump</string>
    <string name="title_activity_main">MyPump</string>
    <string name="package_name">com.pumpteam.mypump</string>
    <string name="custom_url_scheme">com.pumpteam.mypump</string>

    <!-- Health Connect EXIGE que la app muestre su política de privacidad desde
         la propia hoja de permisos. Esa pantalla la pone el plugin
         (PermissionsRationaleActivity), y si este string no existe cae a su
         default: file:///android_asset/public/privacypolicy.html — un archivo
         que en este proyecto NO existe (el nuestro se llama privacidad.html).
         Resultado: el cliente toca "Política de privacidad" y ve un WebView en
         blanco con ERR_FILE_NOT_FOUND. Ni el build ni los tests lo notan, y es
         exactamente el link que Google mira en la Health apps declaration.
         Misma URL que la declarada en la ficha (docs/PLAYSTORE_METADATA.md). -->
    <string name="health_connect_privacy_policy_url">https://app.mypumpteam.com/privacidad</string>
</resources>
