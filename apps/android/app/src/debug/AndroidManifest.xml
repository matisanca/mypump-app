<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo en debug (nunca en lo que va a Play): una actividad vacía donde las pruebas de interfaz arman un componente suelto
  (por ejemplo, el botón que abre una fuente en CustomTabsTest). `ui-test-manifest` declara la misma actividad; acá se
  le pone el tema de la app y se la deja sin exportar (tools:replace), como estaba antes de sumar esa librería.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Salud, SOLO en debug: las pruebas instrumentadas siembran datos de mentira en el Health Connect del EMULADOR
         (androidTest/…/salud/SembradoSalud.kt), y para escribir hace falta permiso de escritura. Nunca llegan a lo que
         va a Play: verificarPermisosSaludRelease falla el build de release si el manifest mergeado trae un WRITE_. -->
    <uses-permission android:name="android.permission.health.WRITE_STEPS" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" />
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.WRITE_BASAL_METABOLIC_RATE" />
    <uses-permission android:name="android.permission.health.WRITE_FLOORS_CLIMBED" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" />
    <uses-permission android:name="android.permission.health.WRITE_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.WRITE_SLEEP" />
    <uses-permission android:name="android.permission.health.WRITE_RESPIRATORY_RATE" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_BODY_FAT" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />

    <application>
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false"
            android:theme="@style/Tema.MyPump"
            tools:replace="android:exported,android:theme" />
    </application>
</manifest>
