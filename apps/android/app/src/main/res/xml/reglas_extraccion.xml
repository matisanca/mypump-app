<?xml version="1.0" encoding="utf-8"?>
<!--
  Qué sale del teléfono desde Android 12 (android:dataExtractionRules): la copia de Google y el pase a un teléfono
  nuevo. Lo mismo que reglas_backup.xml: el token (noBackupFilesDir + clave del Keystore) nunca viaja, y la carpeta de
  cada cuenta (MyPump/) tampoco.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="MyPump/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="MyPump/" />
    </device-transfer>
</data-extraction-rules>
