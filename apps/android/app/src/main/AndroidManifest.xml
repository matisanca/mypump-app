<?xml version="1.0" encoding="utf-8"?>
<!--
  MyPump nativa (Android). Reemplaza a la app Capacitor (android/) como actualización de la MISMA app en Play: mismo
  applicationId, misma actividad de entrada y mismo link del coach.

  Permisos: los de la Capacitor. Los de Health Connect son SOLO de lectura y solo los 13 tipos que se leen más el
  historial (ver el manifest de android/ para el porqué de cada uno). La política de privacidad que exige Health Connect
  para pedirlos la abre PoliticaSaludActivity (abajo). El build de release verifica el manifest MERGEADO
  (verificarPermisosSaludRelease en app/build.gradle.kts): ni un WRITE_, ni un READ_ de más.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Saber cuándo VUELVE la red (MonitorDeRed): manda la cola y reintenta solo una vez desde "Sin conexión" (ACC-05).
         Permiso normal: no se le pide nada al cliente. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Avisos del coach y del fin del descanso (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Avisos: volver a agendar el aviso del domingo después de un reinicio (las alarmas no lo sobreviven). Sin
         SCHEDULE_EXACT_ALARM ni USE_EXACT_ALARM: las alarmas son inexactas a propósito (ver avisos/CentroAvisos). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Health Connect: lectura. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <!-- Sin esto Health Connect corta toda lectura a los últimos 30 días, sin avisar. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <!-- Google rechazó la app el 26-ago-2026 por pedir saturación sin una función que la use. Va con remove (y no
         solo ausente) por si alguna librería la vuelve a meter en el merge. -->
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" tools:node="remove" />

    <!-- Salud: lo que la Capacitor saca y la nativa tampoco pide, con remove por el mismo motivo. Los tres primeros se
         leen en iOS pero no en Android (Google hace justificar cada permiso de salud); los otros, ninguna lo lee. Y
         nada en segundo plano: la salud se sincroniza solo con la app a la vista. -->
    <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_GLUCOSE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_MINDFULNESS" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BASAL_BODY_TEMPERATURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_VO2_MAX" tools:node="remove" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" tools:node="remove" />

    <!-- ── Revisión: las fotos de progreso (REV-02). La foto la saca la app de cámara del teléfono (TakePicture, con el
         ProveedorFotos de abajo) o sale del selector de fotos del sistema: MyPump no pide CAMERA. Va con remove porque,
         si una librería lo metiera en el merge, Android exigiría el permiso concedido hasta para abrir la cámara de otro. -->
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />

    <!-- Android 13 y anteriores: Health Connect es una app aparte y hay que poder consultarla. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- Los navegadores con Custom Tabs (Android 11+ no los deja ver sin esto): abrirEnNavegador fija uno, porque el App
         Link de abajo toma todo app.mypumpteam.com y un link a privacidad.html volvería a la app en vez de abrirse. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <!-- Backup: el token nunca viaja (noBackupFilesDir + clave del Keystore) y la carpeta de cada cuenta tampoco; ver
         res/xml/reglas_backup.xml (hasta Android 11) y reglas_extraccion.xml (12+). -->
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/reglas_backup"
        android:dataExtractionRules="@xml/reglas_extraccion"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Tema.MyPump">

        <!-- `.MainActivity` como en la Capacitor: el launcher guarda el ícono del cliente por nombre de componente,
             y si la actividad cambia de nombre el ícono desaparece de su pantalla al actualizar. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- El link personal del coach (https://app.mypumpteam.com/?t=TOKEN) abre la app, no el navegador.
                 autoVerify: Android valida el dominio contra /.well-known/assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.mypumpteam.com" />
            </intent-filter>
        </activity>

        <!-- ── Avisos (NOT-01…08, D8): ver avisos/CentroAvisos. ── -->

        <!-- El push de los mensajes de Mati (FCM): el token nuevo se registra y, con la app abierta, el aviso se publica. -->
        <service
            android:name=".avisos.ServicioPush"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Las alarmas del domingo y del fin del descanso, y lo que obliga a reagendar el domingo (reinicio, actualización,
             zona y hora). MY_PACKAGE_REPLACED además se lleva lo que dejó la Capacitor. -->
        <receiver
            android:name=".avisos.ReceptorAvisos"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- Con la app en segundo plano FCM muestra el aviso él solo: en el canal de los mensajes (CentroAvisos.CANAL_MENSAJES),
             con el torso en blanco (sin esto usa el ícono de la app, que la barra de estado aplasta a un cuadrado blanco) y
             el esmeralda del ícono. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="mypump_mensajes" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_mypump" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/aviso_acento" />
        <!-- Sin token de FCM hasta que haga falta: la app lo pide con una cuenta y con permiso (nunca en la demo ni sin
             cuenta), y ahí recién se habla con Firebase. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <!-- Salud: la política de privacidad que abre Health Connect. Sin las dos entradas Health Connect no deja pedir
             los permisos (y Play no publica la app): la justificación de la hoja de permisos (hasta Android 13) y el
             uso de los permisos desde los ajustes (Android 14+, solo lo puede abrir el sistema). Las dos muestran
             privacidad.html en una Custom Tab y se cierran (sin pantalla propia). -->
        <activity
            android:name=".salud.PoliticaSaludActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".salud.PoliticaSaludActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- ── Revisión: la cámara del teléfono deja la foto de progreso en cache/camara/ por este provider (solo esa
             carpeta, sin exportar: el permiso se presta para esa foto y nada más). Ver fotos/ProveedorFotos. ── -->
        <provider
            android:name=".fotos.ProveedorFotos"
            android:authorities="${applicationId}.fotos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_fotos" />
        </provider>
    </application>
</manifest>
