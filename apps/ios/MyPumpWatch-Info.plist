<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- La app del Apple Watch (tanda 3, 2.2). Se mezcla con el Info.plist generado; va fuera de la carpeta sincronizada
	     para que no se copie como recurso. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>es-419</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>es-419</string>
		<string>es</string>
	</array>
	<!-- La sesión de entreno sigue con la pantalla apagada o la muñeca baja (FC, calorías y el descanso). -->
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
	</array>
	<key>NSHealthShareUsageDescription</key>
	<string>Pump Team muestra tu frecuencia cardíaca y tus calorías activas mientras entrenás.</string>
	<!-- Permiso de escritura de entrenamientos: abre la sesión de entreno en el reloj y guarda el entreno en Salud al
	     terminar (decisión de Mati, 2.3.0). -->
	<key>NSHealthUpdateUsageDescription</key>
	<string>Pump Team guarda tu entreno de fuerza en Salud y Fitness cuando lo terminás, con su duración y tus calorías.</string>
	<!-- Tanda 4: con el conteo de reps prendido (viene así; se apaga en Mis datos) el reloj usa el acelerómetro y el
	     giroscopio durante las series. Apagado, no se pide ni se usa. -->
	<key>NSMotionUsageDescription</key>
	<string>Pump Team usa el movimiento del reloj durante cada serie para contar tus repeticiones. Queda en el reloj y en tu iPhone, y lo podés apagar en Mis datos.</string>
</dict>
</plist>
