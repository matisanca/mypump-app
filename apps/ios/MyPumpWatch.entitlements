<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- FC y calorías en vivo (HKWorkoutSession). El entreno no se guarda en Salud. -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<!-- El estado que leen las complicaciones (próximo entreno y descanso). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.pumpteam.mypump.reloj</string>
	</array>
</dict>
</plist>
