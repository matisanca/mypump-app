# Copiar a ~/pump-firma-datos/firma.env (chmod 600) y completar. Ningún valor real va al repo.
FIRMA_DB_URL=                 # la misma cadena del pooler que usa el bot (SUPABASE_DB_URL)
FIRMA_SECRETO=                # 64 caracteres al azar: de acá salen los enlaces y los códigos. Si cambia, mueren los enlaces sin firmar.
FIRMA_SECRETO_INTERNO=        # 64 caracteres al azar: lo manda el Apps Script en X-Pump-Firma-Secreto
FIRMA_URL_PUBLICA=https://firma.mypumpteam.com
FIRMA_DATOS=~/pump-firma-datos
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
FIRMA_SMTP_HOST=smtp.yandex.com
FIRMA_SMTP_PUERTO=465
FIRMA_SMTP_USUARIO=info@mypumpteam.com
FIRMA_SMTP_CLAVE=             # contraseña de aplicación de Yandex 360 (en la Mini: ~/pump-firma-datos/yandex.clave; copiarla sin mostrarla)
FIRMA_REMITENTE=Pump Team <info@mypumpteam.com>
FIRMA_CCO_COPIA=              # optativo: copia oculta de cada copia al firmante
FIRMA_CUSTODIA_EMAIL=         # casilla en un proveedor ajeno, que no se use para otra cosa (ya creada: la dirección está en el ESTADO privado)
FIRMA_AVISO_INTERNO_EMAIL=    # a quién avisar si algo queda a medias
FIRMA_FRENADA_REPITE_HORAS=24 # alta frenada por un dato faltante: cada cuánto se repite el aviso
FIRMA_FRENADA_DIAS=14         # ...y durante cuántos días desde la última vez que llegó incompleta
FIRMA_BOT_URL=https://bot.mypumpteam.com/webhook
FIRMA_BOT_SECRETO=            # el ONBOARDING_HEADER_SECRET del bot
FIRMA_TSAS=digicert,globalsign
# FIRMA_OPENSSL=/opt/homebrew/opt/openssl@3/bin/openssl   (hace falta OpenSSL 3; por defecto lo busca solo)
FIRMA_CA_FILE=/etc/ssl/cert.pem
