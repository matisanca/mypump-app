<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.pump.chatsalud — chequea cada hora que Codex siga vivo.

  Por qué existe: la sesión del CLI se vence sola, y un worker que falla en
  silencio se ve idéntico a un worker sin trabajo. Ya pasó dos noches enteras
  con el CLI de Claude en esta misma máquina sin que nadie se enterara.

  Con el chat automático prendido, si Codex muere nadie recibe una respuesta
  mala (el worker degrada a escalar), pero Mati tampoco sabe POR QUÉ de golpe
  tiene que contestar todo a mano — y lo descubre el jueves con 40 mensajes.

  Manda UN WhatsApp cuando se cae y otro cuando vuelve. No repite antes de 8h:
  avisar cada hora serían 24 mensajes por día, y a la segunda noche estarían
  silenciados.

  Instalación:
    cp com.pump.chatsalud.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.pump.chatsalud.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pump.chatsalud</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/matiassancari/agentkit-coach/venv/bin/python</string>
    <string>/Users/matiassancari/pump-centinela/chat_salud.py</string>
  </array>

  <key>StartInterval</key>
  <integer>3600</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/matiassancari/pump-centinela/chatsalud.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/matiassancari/pump-centinela/chatsalud.err</string>

  <key>WorkingDirectory</key>
  <string>/Users/matiassancari/pump-centinela</string>
</dict>
</plist>
